{
  "type": "object",
  "properties": {
    "first_action": {
      "type": "object",
      "properties": {
        "verdict": { "type": "string", "enum": ["match", "partial", "miss"] },
        "reason": { "type": "string" }
      },
      "required": ["verdict", "reason"],
      "additionalProperties": false
    },
    "acts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "party": { "type": "string" },
          "act": { "type": "string", "description": "Under ten words, the way a handler would name it." },
          "covered": { "type": "boolean" },
          "evidence": { "type": "string" }
        },
        "required": ["party", "act", "covered", "evidence"],
        "additionalProperties": false
      }
    },
    "extras": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "party": { "type": "string" },
          "act": { "type": "string" },
          "problem": { "type": "boolean" },
          "note": { "type": "string" }
        },
        "required": ["party", "act", "problem", "note"],
        "additionalProperties": false
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "quote": { "type": "string" },
          "explanation": { "type": "string" }
        },
        "required": ["quote", "explanation"],
        "additionalProperties": false
      }
    },
    "summary": { "type": "string", "description": "Two or three sentences." }
  },
  "required": ["first_action", "acts", "extras", "violations", "summary"],
  "additionalProperties": false
}
